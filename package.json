{
  "name": "panelinha-backend",
  "version": "1.0.0",
  "description": "Backend da plataforma Panelinha - organizador de partidas esportivas informais",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/database/models/**/*.js",
      "!src/interfaces/http/container.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "awilix": "^10.0.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "resend": "^6.10.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4"
  }
}
